/* pages/salary/index.wxss — 复用 app.wxss 正元金设计系统变量 */
.container {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 头部 */
.hero {
  padding: 16rpx 8rpx 20rpx;
  display: flex;
  flex-direction: column;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #171717;
  letter-spacing: 2rpx;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A3A3A3;
}

/* 省份 chips */
.chips {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.chip {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
  background: #FFFFFF;
  color: #6C584B;
  font-size: 26rpx;
  border-radius: 50rpx;
  box-shadow: 0 2rpx 10rpx rgba(40,41,43,0.05);
}
.chip-on {
  background: linear-gradient(135deg, #8B7355 0%, #A08566 100%);
  color: #FFFFFF;
  font-weight: 600;
}

/* 数值卡 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 20rpx rgba(40,41,43,0.06);
}
.value-card { padding-bottom: 24rpx; }
.vc-head {
  display: flex;
  align-items: center;
}
.vc-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #171717;
}
.tag-est, .tag-off {
  margin-left: 14rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.tag-est { background: #FEF0D6; color: #B5792B; }
.tag-off { background: #EAF6EE; color: #07c160; }
.vc-big {
  margin-top: 18rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #8B7355;
  line-height: 1.1;
}
.vc-unit { font-size: 28rpx; font-weight: 400; color: #A3A3A3; margin-left: 10rpx; }
.vc-year { margin-top: 6rpx; font-size: 24rpx; color: #6C584B; }

.year-picker {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FAF8F5;
  border: 1rpx solid #D5CEC3;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
}
.yp-label { font-size: 26rpx; color: #6C584B; }
.yp-value { font-size: 30rpx; font-weight: 600; color: #171717; flex: 1; text-align: center; }
.yp-arrow { font-size: 20rpx; color: #A3A3A3; }

/* 统计 */
.stat-row {
  display: flex;
  margin-bottom: 22rpx;
}
.stat {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 22rpx 8rpx;
  margin: 0 8rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(40,41,43,0.06);
}
.stat-v { display: block; font-size: 30rpx; font-weight: 700; color: #8B7355; }
.stat-k { display: block; margin-top: 6rpx; font-size: 20rpx; color: #A3A3A3; }

/* 趋势图 */
.title { font-size: 30rpx; font-weight: 600; color: #171717; }
.trend-canvas {
  width: 100%;
  height: 420rpx;
  margin-top: 12rpx;
}

/* 排名 */
.rank-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.rank-self { font-size: 22rpx; color: #8B7355; font-weight: 600; }
.rank-list { max-height: 720rpx; overflow-y: auto; }
.rank-item {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid #F0ECE4;
}
.rank-item:last-child { border-bottom: none; }
.rank-on { background: #FEF0D6; border-radius: 12rpx; }
.ri-rank {
  width: 56rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #A3A3A3;
  text-align: center;
}
.rank-on .ri-rank { color: #8B7355; }
.ri-name { flex: 1; font-size: 27rpx; color: #171717; }
.ri-val { font-size: 27rpx; font-weight: 600; color: #6C584B; }

/* 分享 */
.share-row {
  display: flex;
  margin-bottom: 12rpx;
}
.btn-share, .btn-poster {
  flex: 1;
  margin: 0 8rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 0;
  line-height: normal;
}
.btn-share {
  background: linear-gradient(135deg, #8B7355 0%, #A08566 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(139,115,85,0.30);
}
.btn-poster {
  background: #FFFFFF;
  color: #8B7355;
  border: 1rpx solid #8B7355;
}
.btn-share::after, .btn-poster::after { border: none; }

.hint { font-size: 22rpx; color: #A3A3A3; text-align: center; margin-bottom: 20rpx; }

/* 口径说明 */
.disclaimer {
  background: #FBF7F0;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
}
.dc-t { display: block; font-size: 24rpx; font-weight: 600; color: #8B7355; margin-bottom: 8rpx; }
.dc-c { display: block; font-size: 21rpx; color: #A3A3A3; line-height: 1.6; margin-bottom: 6rpx; }

/* 海报离屏 canvas */
.poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 600px;
  height: 800px;
}
